# Copy to .env and fill in. .env is git-ignored; never commit it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# AI_DAILY_CAP=300          # max Claude calls per day (resets at midnight IST); 0 turns AI off
# MISSEDIT_MODEL=claude-opus-5-5
# MISSEDIT_EFFORT=low
# PORT=3000
# OVER_INTERVAL_MS=7000     # one simulated over every 7 seconds
# START_AT_OVER=6           # fast-forward so there is history to catch up on
